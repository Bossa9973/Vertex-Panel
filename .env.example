APP_NAME=Vertex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=convoy
DB_USERNAME=convoy_user
DB_PASSWORD=

CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=525600

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PHP_XDEBUG=false
PHP_XDEBUG_MODE='debug'
# ============================================================
# Google Drive Cloud Backup Integration
# ============================================================
# 1. Create a Google Cloud project and enable the Drive API
# 2. Create a service account and download the JSON key file
# 3. Place the key at storage/app/gdrive-service-account.json
# 4. Share your convoy-backups Drive folder with the service
#    account email and copy the folder ID from its URL
# ============================================================

# ID of the Google Drive folder shared with the service account
# (the long string after /folders/ in the Drive URL)
GDRIVE_BACKUP_FOLDER_ID=1wi6f02OkegTIlZDWUohgH4ohkhbDNbLK

# Absolute path to the service account JSON key file on the server
# Default: storage/app/gdrive-service-account.json
GDRIVE_SERVICE_ACCOUNT_PATH=

# Queue name for UploadBackupToCloudJob (keep separate from default
# to prevent long-running uploads from starving monitor jobs)
BACKUP_UPLOAD_QUEUE=backups
