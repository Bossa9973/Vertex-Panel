APP_NAME=Vertex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=convoy
DB_USERNAME=convoy_user
DB_PASSWORD=

CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=525600

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PHP_XDEBUG=false
PHP_XDEBUG_MODE='debug'
# ============================================================
# Google Drive Cloud Backup Integration
# ============================================================
# Option A: Personal Google Drive (OAuth 2.0 - 5TB / 2TB Personal)
# ------------------------------------------------------------
# 1. Create OAuth Client ID (Desktop App) in Google Cloud Console
# 2. Add 'https://www.googleapis.com/auth/drive' scope & test user
# 3. Obtain refresh token and populate below:
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# Option B: Google Service Account (Google Workspace / Shared Drive)
# ------------------------------------------------------------
# Absolute path to the service account JSON key file on the server
# GDRIVE_SERVICE_ACCOUNT_PATH=storage/app/gdrive-service-account.json

# Folder Name on Google Drive where backups will be stored
# (Default: convoy-backups)
GDRIVE_BACKUP_FOLDER_ID=convoy-backups

# Queue name for UploadBackupToCloudJob (keep separate from default
# to prevent long-running uploads from starving monitor jobs)
BACKUP_UPLOAD_QUEUE=backups

