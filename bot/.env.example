# ─── Discord Bot ──────────────────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications → Bot tab
DISCORD_TOKEN=

# Your Discord Server (Guild) ID
DISCORD_GUILD_ID=

# Role ID that grants admin access to bot commands
DISCORD_ADMIN_ROLE_ID=1354830877149888744

# ─── Panel API ────────────────────────────────────────────────────────────────
# URL of the Laravel panel (no trailing slash)
PANEL_URL=http://localhost

# Shared secret — MUST match BOT_API_SECRET in the panel's .env
BOT_API_SECRET=

# ─── Optional Channel Config ──────────────────────────────────────────────────
# Comma-separated channel IDs to IGNORE for message counting (e.g. bot-spam)
IGNORED_CHANNEL_IDS=

# Channel ID for the showcase channel (leave 0 to disable)
SHOWCASE_CHANNEL_ID=0
